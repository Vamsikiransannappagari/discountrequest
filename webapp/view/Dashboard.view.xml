
<mvc:View
    controllerName="discountrequest.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    height="100%">

    <Page
        id="dashboardPage"
        title="Dashboard"
        enableScrolling="true"
        class="dashboardPage">

        <content>

            <VBox
                id="_IDGenVBox1"
                width="100%"
                class="dashboardContent"
                renderType="Bare">

                <Title
                    id="_IDGenTitle2"
                    text="Dealer Discount Overview"
                    level="H1"
                    class="dashboardHeading"/>

                <Text
                    id="_IDGenText11"
                    text="Monitor dealer discount requests and approval status."
                    class="dashboardDescription"/>

                <!-- Dashboard Tiles -->

                <HBox
                    id="_IDGenHBox"
                    wrap="NoWrap"
                    width="100%"
                    class="dashboardTiles">

                    <!-- Total Requests -->

                    <VBox id="_IDGenVBox2" class="dashboardTileWrapper">
                        <GenericTile
                            id="_IDGenGenericTile"
                            header="Total Requests"
                            subheader="All discount requests"
                            frameType="OneByOne"
                            class="dashboardTile totalTile">

                            <TileContent id="_IDGenTileContent">
                                <NumericContent
                                    id="_IDGenNumericContent"
                                    value="{dashboard>/total}"
                                    icon="sap-icon://documents"
                                    valueColor="Neutral"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <!-- Pending Approval -->

                    <VBox id="_IDGenVBox3" class="dashboardTileWrapper">
                        <GenericTile
                            id="_IDGenGenericTile1"
                            header="Pending Approval"
                            subheader="Awaiting decision"
                            frameType="OneByOne"
                            class="dashboardTile pendingTile">

                            <TileContent id="_IDGenTileContent1">
                                <NumericContent
                                    id="_IDGenNumericContent1"
                                    value="{dashboard>/pending}"
                                    icon="sap-icon://pending"
                                    valueColor="Critical"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <!-- Active Requests -->

                    <VBox id="_IDGenVBox4" class="dashboardTileWrapper">
                        <GenericTile
                            id="_IDGenGenericTile2"
                            header="Active"
                            subheader="Active discount requests"
                            frameType="OneByOne"
                            class="dashboardTile approvedTile">

                            <TileContent id="_IDGenTileContent2">
                                <NumericContent
                                    id="_IDGenNumericContent2"
                                    value="{dashboard>/active}"
                                    icon="sap-icon://accept"
                                    valueColor="Good"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <!-- Rejected Requests -->

                    <VBox id="_IDGenVBox5" class="dashboardTileWrapper">
                        <GenericTile
                            id="_IDGenGenericTile3"
                            header="Rejected"
                            subheader="Rejected requests"
                            frameType="OneByOne"
                            class="dashboardTile rejectedTile">

                            <TileContent id="_IDGenTileContent3">
                                <NumericContent
                                    id="_IDGenNumericContent3"
                                    value="{dashboard>/rejected}"
                                    icon="sap-icon://decline"
                                    valueColor="Error"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <!-- Draft Requests -->

                    <VBox id="_IDGenVBox6" class="dashboardTileWrapper">
                        <GenericTile
                            id="_IDGenGenericTile4"
                            header="Draft Requests"
                            subheader="Not yet submitted"
                            frameType="OneByOne"
                            class="dashboardTile draftTile">

                            <TileContent id="_IDGenTileContent4">
                                <NumericContent
                                    id="_IDGenNumericContent4"
                                    value="{dashboard>/draft}"
                                    icon="sap-icon://edit"
                                    valueColor="Neutral"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                    <!-- Expired Requests -->

                    <VBox id="_IDGenVBox8" class="dashboardTileWrapper">
                        <GenericTile
                            id="_IDGenGenericTile5"
                            header="Expired Requests"
                            subheader="Validity completed"
                            frameType="OneByOne"
                            class="dashboardTile expiredTile">

                            <TileContent id="_IDGenTileContent5">
                                <NumericContent
                                    id="_IDGenNumericContent5"
                                    value="{dashboard>/expired}"
                                    icon="sap-icon://history"
                                    valueColor="Error"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                </HBox>

                <!-- Recent Discount Requests -->

                <VBox
                    id="_IDGenVBox7"
                    width="100%"
                    class="dashboardRecent">

                    <Toolbar
                        id="_IDGenToolbar1"
                        class="dashboardRecentToolbar">

                        <Title
                            id="_IDGenTitle4"
                            text="Recent Discount Requests"
                            level="H2"/>

                        <ToolbarSpacer id="_IDGenToolbarSpacer2"/>

                        <Button
                            id="_IDGenButton4"
                            text="View All Requests"
                            icon="sap-icon://list"
                            type="Transparent"
                            press="onViewAllRequests"/>
                    </Toolbar>

                    <Table
                        id="_IDGenTable"
                        class="dashboardRecentTable"
                        items="{dashboard>/recentRequests}"
                        noDataText="No recent requests found"
                        growing="true"
                        growingScrollToLoad="true">

                        <columns>

                            <Column id="_IDGenColumn7">
                                <Text
                                    id="_IDGenText12"
                                    text="Request Number"/>
                            </Column>

                            <Column id="_IDGenColumn8">
                                <Text
                                    id="_IDGenText13"
                                    text="Valid From"/>
                            </Column>

                            <Column id="_IDGenColumn9">
                                <Text
                                    id="_IDGenText14"
                                    text="Valid To"/>
                            </Column>

                            <Column id="_IDGenColumn10" hAlign="End">
                                <Text
                                    id="_IDGenText15"
                                    text="Net Price"/>
                            </Column>

                            <Column id="_IDGenColumn11">
                                <Text
                                    id="_IDGenText18"
                                    text="Status"/>
                            </Column>

                        </columns>

                        <items>
                            <ColumnListItem id="_IDGenColumnListItem1">
                                <cells>

                                    <Text
                                        id="_IDGenText16"
                                        text="{dashboard>requestNumber}"/>

                                    <Text
                                        id="_IDGenText17"
                                        text="{dashboard>validFrom}"/>

                                    <Text
                                        id="_IDGenText19"
                                        text="{dashboard>validTo}"/>

                                    <Text
                                        id="_IDGenText20"
                                        text="{= '₹ ' + ${dashboard>totalNetPrice} }"
                                        textAlign="End"/>

                                    <ObjectStatus
                                        id="_IDGenObjectStatus2"
                                        text="{dashboard>statusText}"
                                        state="{dashboard>statusState}"/>

                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>
