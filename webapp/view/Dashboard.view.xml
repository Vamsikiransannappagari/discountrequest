
<mvc:View
    controllerName="discountrequest.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    height="100%">

    <Page
        id="dashboardPage"
        title="Dashboard"
        enableScrolling="true"
        class="dashboardPage">

        <content>

            <VBox
                id="_IDGenVBox1"
                width="100%"
                class="dashboardContent"
                renderType="Bare">

                <!-- Dashboard Heading -->

                <Title
                    id="_IDGenTitle2"
                    text="Dealer Discount Overview"
                    level="H1"
                    class="dashboardHeading"/>

                <Text
                    id="_IDGenText11"
                    text="Monitor dealer discount requests and approval status."
                    class="dashboardDescription"/>


                <!-- Dashboard Statistics Cards -->

                <HBox
                    id="dashboardTiles"
                    width="100%"
                    wrap="Wrap"
                    class="dashboardTiles">

                    <!-- Total Requests -->

                    <VBox
                        id="_IDGenVBox2"
                        class="dashboardTileCard totalCard">

                        <HBox id="_IDGenHBox"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox id="_IDGenVBox10">
                                <Text id="_IDGenText13"
                                    text="Total Requests"
                                    class="tileLabel"/>

                                <Text id="_IDGenText14"
                                    text="All discount requests"
                                    class="tileSubtitle"/>
                            </VBox>

                            <HBox id="_IDGenHBox1" class="tileIcon totalIcon">
                                <core:Icon id="_IDGenIcon"
                                    src="sap-icon://documents"
                                    size="1.3rem"/>
                            </HBox>

                        </HBox>

                        <Title id="_IDGenTitle8"
                            text="{dashboard>/total}"
                            level="H1"
                            class="tileNumber"/>

                        <Text id="_IDGenText15"
                            text="Overall requests"
                            class="tileFooter"/>

                    </VBox>


                    <!-- Pending Approval -->

                    <VBox
                        id="_IDGenVBox3"
                        class="dashboardTileCard pendingCard">

                        <HBox id="_IDGenHBox2"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox id="_IDGenVBox11">
                                <Text id="_IDGenText18"
                                    text="Pending Approval"
                                    class="tileLabel"/>

                                <Text id="_IDGenText31"
                                    text="Awaiting decision"
                                    class="tileSubtitle"/>
                            </VBox>

                            <HBox id="_IDGenHBox3" class="tileIcon pendingIcon">
                                <core:Icon id="_IDGenIcon1"
                                    src="sap-icon://pending"
                                    size="1.3rem"/>
                            </HBox>

                        </HBox>

                        <Title id="_IDGenTitle9"
                            text="{dashboard>/pending}"
                            level="H1"
                            class="tileNumber"/>

                        <Text id="_IDGenText32"
                            text="Requires approval"
                            class="tileFooter"/>

                    </VBox>


<!-- Approved Requests -->

<VBox
    id="_IDGenVBox4"
    class="dashboardTileCard approvedCard">

    <HBox id="_IDGenHBox5"
        justifyContent="SpaceBetween"
        alignItems="Center">

        <VBox id="_IDGenVBox12">
            <Text id="_IDGenText12"
                text="Approved Requests"
                class="tileLabel"/>

            <Text id="_IDGenText33"
                text="Successfully approved"
                class="tileSubtitle"/>
        </VBox>

        <HBox id="_IDGenHBox12" class="tileIcon approvedIcon">
            <core:Icon id="_IDGenIcon2"
                src="sap-icon://accept"
                size="1.3rem"/>
        </HBox>

    </HBox>

    <Title id="_IDGenTitle10"
        text="{dashboard>/approved}"
        level="H1"
        class="tileNumber"/>

    <Text id="_IDGenText34"
        text="Approval completed"
        class="tileFooter"/>

</VBox>


                    <!-- Rejected Requests -->

                    <VBox
                        id="_IDGenVBox5"
                        class="dashboardTileCard rejectedCard">

                        <HBox id="_IDGenHBox6"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox id="_IDGenVBox13">
                                <Text id="_IDGenText36"
                                    text="Rejected Requests"
                                    class="tileLabel"/>

                                <Text id="_IDGenText37"
                                    text="Declined requests"
                                    class="tileSubtitle"/>
                            </VBox>

                            <HBox id="_IDGenHBox7" class="tileIcon rejectedIcon">
                                <core:Icon id="_IDGenIcon3"
                                    src="sap-icon://decline"
                                    size="1.3rem"/>
                            </HBox>

                        </HBox>

                        <Title id="_IDGenTitle11"
                            text="{dashboard>/rejected}"
                            level="H1"
                            class="tileNumber"/>

                        <Text id="_IDGenText38"
                            text="Approval not granted"
                            class="tileFooter"/>

                    </VBox>


                    <!-- Draft Requests -->

                    <VBox
                        id="_IDGenVBox6"
                        class="dashboardTileCard draftCard">

                        <HBox id="_IDGenHBox8"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox id="_IDGenVBox14">
                                <Text id="_IDGenText39"
                                    text="Draft Requests"
                                    class="tileLabel"/>

                                <Text id="_IDGenText40"
                                    text="Not yet submitted"
                                    class="tileSubtitle"/>
                            </VBox>

                            <HBox id="_IDGenHBox9" class="tileIcon draftIcon">
                                <core:Icon id="_IDGenIcon4"
                                    src="sap-icon://edit"
                                    size="1.3rem"/>
                            </HBox>

                        </HBox>

                        <Title id="_IDGenTitle12"
                            text="{dashboard>/draft}"
                            level="H1"
                            class="tileNumber"/>

                        <Text id="_IDGenText41"
                            text="Awaiting submission"
                            class="tileFooter"/>

                    </VBox>


                    <!-- Expired Requests -->

                    <VBox
                        id="_IDGenVBox8"
                        class="dashboardTileCard expiredCard">

                        <HBox id="_IDGenHBox10"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox id="_IDGenVBox15">
                                <Text id="_IDGenText42"
                                    text="Expired Requests"
                                    class="tileLabel"/>

                                <Text id="_IDGenText43"
                                    text="Validity completed"
                                    class="tileSubtitle"/>
                            </VBox>

                            <HBox id="_IDGenHBox11" class="tileIcon expiredIcon">
                                <core:Icon id="_IDGenIcon5"
                                    src="sap-icon://history"
                                    size="1.3rem"/>
                            </HBox>

                        </HBox>

                        <Title id="_IDGenTitle13"
                            text="{dashboard>/expired}"
                            level="H1"
                            class="tileNumber"/>

                        <Text id="_IDGenText44"
                            text="Validity period ended"
                            class="tileFooter"/>

                    </VBox>

                </HBox>


                <!-- Recent Discount Requests -->

                <VBox
                    id="_IDGenVBox7"
                    width="100%"
                    class="dashboardRecent">

                    <Toolbar
                        id="_IDGenToolbar1"
                        class="dashboardRecentToolbar">

                        <Title
                            id="_IDGenTitle4"
                            text="Recent Discount Requests"
                            level="H2"/>

                        <ToolbarSpacer
                            id="_IDGenToolbarSpacer2"/>

                        <Button
                            id="_IDGenButton4"
                            text="View All Requests"
                            icon="sap-icon://list"
                            type="Transparent"
                            press="onViewAllRequests"/>

                    </Toolbar>


                    <!-- Recent Requests Table -->

                    <Table
                        id="_IDGenTable"
                        class="dashboardRecentTable"
                        fixedLayout="true"
                        items="{dashboard>/recentRequests}"
                        noDataText="No recent requests found"
                        growing="true"
                        growingScrollToLoad="true">

                        <columns>

                            <Column
                                id="_IDGenColumn7"
                                width="22%">

                                <Text id="_IDGenText45" text="Request Number"/>

                            </Column>

                            <Column
                                id="_IDGenColumn8"
                                width="18%">

                                <Text id="_IDGenText46" text="Valid From"/>

                            </Column>

                            <Column
                                id="_IDGenColumn9"
                                width="18%">

                                <Text id="_IDGenText47" text="Valid To"/>

                            </Column>

                            <Column
                                id="_IDGenColumn10"
                                width="18%"
                                >

                                <Text id="_IDGenText48" text="Net Price"/>

                            </Column>

                            <Column
                                id="_IDGenColumn11"
                                width="24%">

                                <Text id="_IDGenText49" text="Status"/>

                            </Column>

                        </columns>


                        <items>

                            <ColumnListItem
                                id="_IDGenColumnListItem1"
                                type="Inactive">

                                <cells>

                                    <Text
                                        id="_IDGenText16"
                                        text="{dashboard>requestNumber}"/>

                                    <Text
                                        id="_IDGenText17"
                                        text="{dashboard>validFrom}"/>

                                    <Text
                                        id="_IDGenText19"
                                        text="{dashboard>validTo}"/>

                                    <Text
                                        id="_IDGenText20"
                                        text="{= '₹ ' + ${dashboard>totalNetPriceText} }"
                                        textAlign="End"/>

                                    <ObjectStatus
                                        id="_IDGenObjectStatus2"
                                        text="{dashboard>statusText}"
                                        state="{dashboard>statusState}"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>
