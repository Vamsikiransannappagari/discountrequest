
<mvc:View
    controllerName="discountrequest.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    height="100%">

    <Page
        id="discountRequestPage"
        title="Discount Requests"
        showHeader="true"
        enableScrolling="true">

        <content>
            <VBox
                id="_IDGenVBox"
                width="100%"
                class="sapUiSmallMargin">

                <!-- Main Toolbar -->
                <Toolbar id="_IDGenToolbar">

                    <Title
                        id="_IDGenTitle"
                        text="Discount Request List"
                        level="H2"/>

                    <ToolbarSpacer id="_IDGenToolbarSpacer"/>

                    <Button
                        id="_IDGenButton"
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press="onRefresh"/>

                    <Button
                        id="_IDGenButton1"
                        text="Create Request"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press="onCreateRequest"/>

                </Toolbar>

                <!-- Search -->
                <SearchField
                    id="requestSearch"
                    width="100%"
                    placeholder="Search by request number or reason"
                    liveChange="onSearch"
                    search="onSearch"
                    class="sapUiSmallMarginBottom"/>

                <!-- Request Actions -->
                <Toolbar id="requestActionToolbar">

                    <Title
                        id="selectedRequestTitle"
                        text="Request Actions"
                        level="H4"/>

                    <ToolbarSpacer id="_IDGenToolbarSpacer3"/>

                    <Button
                        id="editRequestButton"
                        text="Edit"
                        icon="sap-icon://edit"
                        enabled="false"
                        press="onEditRequest"/>

                    <!-- <Button
                        id="viewRequestButton"
                        text="View Details"
                        icon="sap-icon://display"
                        enabled="false"
                        press="onViewDetails"/> -->

                    <Button
                        id="cancelRequestButton"
                        text="Cancel Request"
                        icon="sap-icon://decline"
                        type="Reject"
                        enabled="false"
                        press="onCancelRequest"/>

                </Toolbar>

                <!-- Discount Request Table -->
                <Table
                    id="requestsTable"
                    width="100%"
                    growing="true"
                    growingScrollToLoad="true"
                    growingThreshold="20"
                    mode="SingleSelectLeft"
                    selectionChange="onRequestSelectionChange"
                    noDataText="No discount requests found"
                    items="{/DiscountRequests}">

                    <columns>

                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText1" text="Request Number"/>
                        </Column>

                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText2" text="Reason"/>
                        </Column>

                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText3" text="Valid From"/>
                        </Column>

                        <Column id="_IDGenColumn3">
                            <Text id="_IDGenText4" text="Valid To"/>
                        </Column>

                        <Column
                            id="_IDGenColumn4"
                            hAlign="End">
                            <Text id="_IDGenText5" text="Net Price"/>
                        </Column>

                        <Column
                            id="_IDGenColumn5"
                            hAlign="End">
                            <Text id="_IDGenText6" text="Total Discount Price"/>
                        </Column>

                        <Column id="_IDGenColumn6">
                            <Text id="_IDGenText7" text="Status"/>
                        </Column>

                    </columns>

                    <items>
                        <ColumnListItem
                            id="_IDGenColumnListItem"
                            type="Inactive">

                            <cells>

                                <Text id="_IDGenText8" text="{requestNumber}"/>

                                <Text id="_IDGenText9"
                                    text="{reason}"
                                    wrapping="true"/>

                                <Text id="_IDGenText10" text="{validFrom}"/>

                                <Text id="_IDGenText21" text="{validTo}"/>

                                <Text id="_IDGenText22"
                                    text="{= '₹ ' + ${totalNetPrice} }"
                                    textAlign="End"/>

                                <Text id="_IDGenText23"
                                    text="{= '₹ ' + ${totalDiscountPrice} }"
                                    textAlign="End"/>

                                <ObjectStatus
                                    id="_IDGenObjectStatus1"
                                    text="{status}"
                                    state="{
                                        path: 'status',
                                        formatter: '.formatStatus'
                                    }"/>

                            </cells>

                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>

    </Page>

</mvc:View>
