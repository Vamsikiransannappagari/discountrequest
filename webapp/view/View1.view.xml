<mvc:View
    controllerName="discountrequest.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    height="100%">

    <Page
        id="discountRequestPage"
        showHeader="false"
        enableScrolling="true"
        backgroundDesign="Transparent"
        class="drPage">

        <content>
            <VBox id="_IDGenVBox" class="drContainer">

                <!-- Page header -->
                <FlexBox id="_IDGenFlexBox"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    wrap="Wrap"
                    class="drHeader">

                    <VBox id="_IDGenVBox16">
                        <Title id="_IDGenTitle" text="Discount requests" level="H1" titleStyle="H2"/>
                        <Text id="_IDGenText1"
                            text="Review, edit and track discount requests from your dealers."
                            class="drSubtitle"/>
                    </VBox>

                    <HBox id="_IDGenHBox4" alignItems="Center">
                        <Button id="_IDGenButton"
                            text="Refresh"
                            icon="sap-icon://refresh"
                            type="Transparent"
                            press="onRefresh"/>
                        <Button id="_IDGenButton1"
                            text="Create request"
                            icon="sap-icon://add"
                            type="Emphasized"
                            class="sapUiTinyMarginBegin"
                            press="onCreateRequest"/>
                    </HBox>
                </FlexBox>

                <!-- Summary cards (colour stripe = status colour) -->
                <HBox id="_IDGenHBox13" class="drKpiRow" wrap="Wrap">

                    <VBox id="_IDGenVBox17" class="drKpi drKpiPending">
                        <Text id="_IDGenText2" text="Pending approval" class="drKpiLabel"/>
                        <Text id="_IDGenText3" text="{view>/counts/pending}" class="drKpiValue"/>
                        <Text id="_IDGenText4" text="{view>/pendingValue} in discounts" class="drKpiHint"/>
                    </VBox>

                    <VBox id="_IDGenVBox18" class="drKpi drKpiApproved">
                        <Text id="_IDGenText5" text="Approved" class="drKpiLabel"/>
                        <Text id="_IDGenText6" text="{view>/counts/approved}" class="drKpiValue"/>
                        <Text id="_IDGenText7" text="Approved or active" class="drKpiHint"/>
                    </VBox>

                    <VBox id="_IDGenVBox19" class="drKpi drKpiDraft">
                        <Text id="_IDGenText8" text="Drafts" class="drKpiLabel"/>
                        <Text id="_IDGenText9" text="{view>/counts/draft}" class="drKpiValue"/>
                        <Text id="_IDGenText10" text="Not yet submitted" class="drKpiHint"/>
                    </VBox>

                    <VBox id="_IDGenVBox20" class="drKpi drKpiRejected">
                        <Text id="_IDGenText21" text="Rejected" class="drKpiLabel"/>
                        <Text id="_IDGenText22" text="{view>/counts/rejected}" class="drKpiValue"/>
                        <Text id="_IDGenText23" text="Out of {view>/counts/all} requests" class="drKpiHint"/>
                    </VBox>

                </HBox>

                <!-- Requests table -->
                <VBox id="_IDGenVBox21" class="drCard">
                    <Table
                        id="requestsTable"
                        class="drTable"
                        width="100%"
                        growing="true"
                        growingScrollToLoad="true"
                        growingThreshold="20"
                        mode="SingleSelectMaster"
                        sticky="ColumnHeaders,HeaderToolbar"
                        popinLayout="GridSmall"
                        selectionChange="onRequestSelectionChange"
                        updateFinished="onTableUpdateFinished"
                        noDataText="No requests match your filters. Clear the search or choose All."
                        items="{/DiscountRequests}">

                        <headerToolbar>
                            <OverflowToolbar id="_IDGenOverflowToolbar1" class="drTableToolbar">

                                <SegmentedButton
                                    id="statusFilter"
                                    selectedKey="All"
                                    selectionChange="onStatusFilterChange">
                                    <items>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem" key="All" text="All"/>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem1" key="Draft" text="Draft"/>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem2" key="PendingApproval" text="Pending"/>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem3" key="Approved" text="Approved"/>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem4" key="Rejected" text="Rejected"/>
                                    </items>
                                </SegmentedButton>

                                <ToolbarSpacer id="_IDGenToolbarSpacer"/>

                                <SearchField
                                    id="requestSearch"
                                    width="18rem"
                                    placeholder="Search request number or reason"
                                    liveChange="onSearch"
                                    search="onSearch"/>

                                <ToolbarSeparator id="_IDGenToolbarSeparator"/>

                                <Button
                                    id="editRequestButton"
                                    text="Edit"
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    enabled="false"
                                    press="onEditRequest"/>

                                <Button
                                    id="cancelRequestButton"
                                    text="Delete draft"
                                    icon="sap-icon://delete"
                                    type="Reject"
                                    enabled="false"
                                    press="onCancelRequest"/>

                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column id="_IDGenColumn" width="11rem">
                                <Text id="_IDGenText29" text="Request"/>
                            </Column>
                            <Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true">
                                <Text id="_IDGenText30" text="Reason"/>
                            </Column>
                            <Column id="_IDGenColumn2" minScreenWidth="Desktop" demandPopin="true" width="8rem">
                                <Text id="_IDGenText35" text="Valid from"/>
                            </Column>
                            <Column id="_IDGenColumn3" minScreenWidth="Desktop" demandPopin="true" width="8rem">
                                <Text id="_IDGenText50" text="Valid to"/>
                            </Column>
                            <Column id="_IDGenColumn4" minScreenWidth="Tablet" demandPopin="true" width="9rem">
                                <Text id="_IDGenText51" text="Net price"/>
                            </Column>
                            <Column id="_IDGenColumn5" minScreenWidth="Tablet" demandPopin="true" width="9rem">
                                <Text id="_IDGenText52" text="Total discount"/>
                            </Column>
                            <Column id="_IDGenColumn6" width="10rem">
                                <Text id="_IDGenText53" text="Status"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="_IDGenColumnListItem"
                                type="Navigation"
                                press="onRowPress">
                                <cells>

                                    <ObjectIdentifier id="_IDGenObjectIdentifier1" title="{requestNumber}"/>

                                    <Text id="_IDGenText54"
                                        text="{reason}"
                                        maxLines="2"/>

                                    <Text id="_IDGenText55" text="{validFrom}"/>

                                    <Text id="_IDGenText56" text="{validTo}"/>

                                    <Text id="_IDGenText57"
                                        text="{path: 'totalNetPrice', formatter: '.formatAmount'}"
                                        class="drAmount"/>

                                    <Text id="_IDGenText58"
                                        text="{path: 'totalDiscountPrice', formatter: '.formatAmount'}"
                                        class="drAmount drAmountStrong"/>

                                    <ObjectStatus id="_IDGenObjectStatus"
                                        text="{status}"
                                        inverted="true"
                                        class="drStatus"
                                        state="{path: 'status', formatter: '.formatStatus'}"
                                        icon="{path: 'status', formatter: '.formatStatusIcon'}"/>

                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </VBox>

            </VBox>
        </content>

    </Page>

</mvc:View>