{
  "_version": "1.90.0",
  "sap.app": {
    "id": "discountrequest",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "cbd33d87-4f22-45ca-92c3-66921d9e0c94"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/dealer/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "dealerrequest-requesting": {
          "semanticObject": "dealerrequest",
          "action": "requesting",
          "title": "{{dealerrequest-requesting.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
         "sap.tnt": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "discountrequest.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
 
"routing": {
    "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "discountrequest.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
    },
    "routes": [
        {
            "name": "dashboard",
            "pattern": "",
            "target": "Dashboard"
        },
        {
            "name": "requests",
            "pattern": "requests",
            "target": "Requests"
        },
        {
            "name": "objectPage",
            "pattern": "requests/{requestId}/{mode}",
            "target": "ObjectPage"
        }
    ],
"targets": {
    "Dashboard": {
        "viewName": "Dashboard",
        "viewId": "Dashboard",
        "viewType": "XML"
    },
    "Requests": {
        "viewName": "View1",
        "viewId": "View1",
        "viewType": "XML"
    },
    "ObjectPage": {
        "viewName": "ObjectPage",
        "viewId": "ObjectPage",
        "viewType": "XML"
    }
}
},
    "rootView": {
      "viewName": "discountrequest.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "discountrequest"
  }
}
